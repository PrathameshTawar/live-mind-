# LiveMind Configuration Environment Variables
# Copy this file to .env and customize values for your deployment

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO

# Jira Connector Configuration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_API_TOKEN=your-jira-api-token
JIRA_USER_EMAIL=engineer@example.com
JIRA_PROJECT_KEYS=PAY,CORE,INFRA

# Notion Connector Configuration
NOTION_API_KEY=secret_your_notion_integration_token
NOTION_DATABASE_ID=your-notion-database-id

# Retrieval & Hybrid Search Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HYBRID_RRF_K=60
HYBRID_RETRIEVAL_TOP_K=5

# Memory Service Configuration
MEMORY_STORAGE_PATH=./livemind_memory.db
MEMORY_DEFAULT_TTL_DAYS=30
MEMORY_SIMILARITY_THRESHOLD=0.75

# Multi-Hop Reasoning Agent
RESEARCH_MAX_HOPS=4
RESEARCH_CONFIDENCE_THRESHOLD=0.70
